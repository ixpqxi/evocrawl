APPNAME=kanboard
MODE=Crawler
INPUT=1
RESTART_KAFKA=1
START_CRAWLER=1

# Target and login configuration rendered into utils-evo/login_information.json
# Use host.docker.internal for a target running on the Docker host.
TARGET_URL=http://host.docker.internal:8300/
LOGIN_CRAWLER_USER=admin
LOGIN_PASSWORD=admin
LOGIN_TOKEN_USER=admin
LOGIN_FILTER_USER=userA
LOGIN_DETECTOR_USER=admin
LOGIN_USER_B=userB
LOGIN_TOKEN_NAME=sid
LOGIN_FOLDER=

# Optional configurable login profile for APPNAME.
# Set all three selector variables together to override utils-evo/login.js hardcoded login branches.
# Example for many simple login forms, including memos-like forms:
# LOGIN_USERNAME_SELECTOR=input[type="text"]
# LOGIN_PASSWORD_SELECTOR=input[type="password"]
# LOGIN_SUBMIT_SELECTOR=button.btn-primary
LOGIN_USERNAME_SELECTOR=
LOGIN_USERNAME_NTH=
LOGIN_PASSWORD_SELECTOR=
LOGIN_PASSWORD_NTH=
LOGIN_SUBMIT_SELECTOR=
LOGIN_SUBMIT_NTH=
LOGIN_POST_WAIT_MS=1000

MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306
TESTCAFE_BROWSER=chrome --headless --no-sandbox --disable-dev-shm-usage
NODE_OPTIONS=--max-old-space-size=5120
